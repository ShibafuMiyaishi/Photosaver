# server/.env.example
# 新サーバー(Ubuntu ミニ PC)用の環境変数テンプレート。
# コピーして使う: cp .env.example .env
# 実物の .env は絶対にコミットしない(.gitignore 済み)。
# 変数の一覧: https://docs.immich.app/install/environment-variables

# ============================================================
# ストレージ
# ============================================================

# 写真原本の保存先(外付け HDD、Btrfs、fstab で UUID マウント)
# docs/new-server-setup.md の手順 6 でマウントした場所に合わせる
UPLOAD_LOCATION=/mnt/photo/immich-library

# Postgres データの保存先(内蔵 NVMe、ext4)。
# HDD や NTFS/exFAT には絶対に置かない(公式要件)。
DB_DATA_LOCATION=/srv/photosaver/postgres

# ============================================================
# Immich バージョン
# ============================================================

# v3 メタタグ = v3 系の最新パッチ/マイナーに追従(メジャー越えはしない)。
# 公式ポリシーで破壊的変更はメジャーのみのため、この指定が推奨バランス。
# 移行時は docs/migration-runbook.md に従い一時的に完全固定(例: v3.1.0)する。
IMMICH_VERSION=v3

# ============================================================
# シークレット
# ============================================================

# 変更必須。英数字のみ(A-Za-z0-9)で 32 文字以上を推奨。
# 生成例: openssl rand -hex 24
DB_PASSWORD=CHANGE_ME_ALNUM_ONLY

# ============================================================
# その他
# ============================================================

TZ=Asia/Tokyo

# 以下は変更不要
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
