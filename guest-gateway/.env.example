# guest-gateway/.env.example
# ミニPCの /srv/photosaver/guest-gateway/.env にコピーして値を埋める(権限 600)。
# 実物の .env は絶対にコミットしない。値に $ を含めないこと(compose が変数展開する)。

# Tailscale 管理画面で発行した認証キー(Tags: tag:wedding-gw / Reusable オフ / Ephemeral オフ)
TS_AUTHKEY=
# 公開 URL のマシン名部分(https://<この名前>.<tailnet>.ts.net)。個人名を入れない
TS_HOSTNAME=guest-upload

# NVMe 上の作業ディレクトリ。中身: ts-state/(Tailscale の状態)、db/(取り込みの記録。uid 1000 で作成)、
# immich.env(scripts/setup-event.js が書き出す Immich 接続情報。無ければ速度検証モード)
GW_DATA_DIR=/srv/photosaver/guest-gateway
# アップロード途中のファイルの置き場(写真 HDD 上。事前に作成し uid 1000 に chown)
STAGING_DIR_HOST=/mnt/photo/guest-gateway/staging
# 写真 HDD のマウント確認用マーカー(docs/new-server-setup.md で HDD 直下に作成するファイル)。
# 無いと窓口は起動せず、アップロードも受け付けない
MOUNT_MARKER_HOST=/mnt/photo/.photosaver.mount-ok

# Cookie 署名鍵: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX
# 合言葉のハッシュ(ミニPCには Node が無いので、ビルドしたイメージで生成する):
#   docker build -t guest-gateway /srv/photosaver/repo/guest-gateway
#   read -rs P && printf '%s' "$P" | docker run --rm -i guest-gateway node scripts/hash-password.js; unset P
# (Mac の開発環境なら guest-gateway/ で: read -rs P && printf '%s' "$P" | npm run -s hash-password; unset P)
GUEST_PASSWORD_HASH=
# 受付期限(これを過ぎると窓口は全機能停止)。タイムゾーン必須
CLOSES_AT=2026-10-31T23:59:00+09:00

# 1 ファイルの上限 / 受付を止める HDD 空き容量の下限(GB)
MAX_FILE_GB=4
MIN_FREE_GB=10
# 速度検証モード(immich.env が無いとき)だけ有効: true にすると受信したファイルを削除せず残す
KEEP_UPLOADS=false
