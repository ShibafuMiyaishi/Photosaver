# guest-gateway/.env.example
# ミニPCの /srv/photosaver/guest-gateway/.env にコピーして値を埋める(権限 600)。
# 実物の .env は絶対にコミットしない。値に $ を含めないこと(compose が変数展開する)。

# Tailscale 管理画面で発行した認証キー(Tags: tag:wedding-gw / Reusable オフ / Ephemeral オフ)
TS_AUTHKEY=
# 公開 URL のマシン名部分(https://<この名前>.<tailnet>.ts.net)。個人名を入れない
TS_HOSTNAME=guest-upload

# Tailscale の状態などを置くディレクトリ(NVMe)
GW_DATA_DIR=/srv/photosaver/guest-gateway
# アップロード途中のファイルの置き場(写真 HDD 上。事前に作成し uid 1000 に chown)
STAGING_DIR_HOST=/mnt/photo/guest-gateway/staging

# Cookie 署名鍵: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX
# 合言葉のハッシュ: read -rs P && printf '%s' "$P" | npm run -s hash-password; unset P
GUEST_PASSWORD_HASH=
# 受付期限(これを過ぎると窓口は全機能停止)。タイムゾーン必須
CLOSES_AT=2026-10-31T23:59:00+09:00

# 1 ファイルの上限 / 受付を止める HDD 空き容量の下限(GB)
MAX_FILE_GB=4
MIN_FREE_GB=10
# 速度検証版: true にすると受信したファイルを削除せず残す(iPhone の形式確認用)
KEEP_UPLOADS=false
